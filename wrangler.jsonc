{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-ttt",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "2bc0e0b7-099f-4e5c-99c9-38686bf08d5e","database_name": "web-ttt" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "541b7242187e4305a49448612f61b6c0" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
